PORT=3000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
AUTO_MIGRATE=false
# Alternativa ao DB_HOST/DB_USER: URL fornecida pelo Neon, incluindo sslmode=require.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitoramento_fadiga
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Assistente: uma única chave do dono, somente no servidor.
# Use Groq Free, sem método de pagamento ou upgrade.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
