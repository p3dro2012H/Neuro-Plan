{
  "name": "monitoramento-fadiga-api",
  "version": "1.0.0",
  "description": "API que recebe alertas de fadiga do módulo de visão computacional e aplica a regra de negócio das pausas.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "demo": "tsx src/demo.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "bcryptjs": "^3.0.2",
    "express-rate-limit": "^8.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "tsx": "^4.20.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "@electric-sql/pglite": "^0.3.14"
  }
}
